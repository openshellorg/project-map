name "project-map"
description "Detect technology stacks in a directory tree and classify files by role"
authors "OpenShellOrg"
license "MIT"
# Version comes from git tags (vX.Y.Z). Do not set "version" here —
# code.dlang.org rejects tags when the recipe version field disagrees.
targetType "library"
sourcePaths "lib/source"
importPaths "lib/source"
dependency "sdlang-d" version="~>0.10.6"
dependency "json5-dlang" repository="git+https://github.com/dlang-supplemental/json5-dlang.git" version="~main"
versions "ProjectMapEmbeddedProfiles"
